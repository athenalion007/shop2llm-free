#. Plugin Name
msgid "Shop2LLM — AI Visibility"
msgstr "Shop2LLM — AI 可见度"

#. Plugin URI / Author URI
msgid "https://shop2llm.com/"
msgstr "https://shop2llm.com/"

#. Description
msgid "Your WordPress site is invisible to ChatGPT, Perplexity, and AI search. Fix that in 2 clicks — Shop2LLM gives you a real-time AI visibility score, auto-generates llms.txt, and tracks 12 AI crawlers."
msgstr "你的 WordPress 网站在 ChatGPT、Perplexity 和 AI 搜索中不可见。2 步修复 — Shop2LLM 提供实时 AI 可见度评分、自动生成 llms.txt 并追踪 12 个 AI 爬虫。"

#. Author
msgid "FinCore"
msgstr "FinCore"

msgid "Upgrade to Pro"
msgstr "升级到 Pro"

#, php-format
msgid "🎉 %s just discovered your store!"
msgstr "🎉 %s 刚刚发现了你的店铺！"

#, php-format
msgid "🎉 %s just discovered your site!"
msgstr "🎉 %s 刚刚发现了你的网站！"

msgid "Your products are now visible to AI assistants. View your AI visibility dashboard:"
msgstr "你的产品现已对 AI 助手可见。查看 AI 可见度仪表盘："

msgid "Your content is now visible to AI assistants. View your AI visibility dashboard:"
msgstr "你的内容现已对 AI 助手可见。查看 AI 可见度仪表盘："

msgid "Open Shop2LLM Dashboard"
msgstr "打开 Shop2LLM 仪表盘"

#, php-format
msgid "🚀 %s — and AI consumers are already searching!"
msgstr "🚀 %s — AI 消费者已经开始搜索了！"

msgid "Your store is live on AI. 174 other stores joined this week — your rating helps us grow!"
msgstr "你的店铺已在 AI 上线。本周 174 家店铺加入 — 你的评价能帮助我们成长！"

msgid "Your site is live on AI. 174 other sites joined this week — your rating helps us grow!"
msgstr "你的网站已在 AI 上线。本周 174 个网站加入 — 你的评价能帮助我们成长！"

msgid "⭐ Leave a Review on WP.org"
msgstr "⭐ 在 WP.org 留下评价"

