msgstr "WooCommerce 未激活。按价格/分类/库存的产品搜索、产品 AI 评分和产品信息流 XML 不可用。安装 WooCommerce 获取完整体验。"

msgid "Install →"
msgstr "安装 →"

msgid "Store AI-Ready"
msgstr "店铺 AI 就绪"

msgid "Site AI-Ready"
msgstr "网站 AI 就绪"

msgid "Schema + llms.txt + robots.txt auto-generated"
msgstr "Schema + llms.txt + robots.txt 自动生成"

msgid "Products Indexed"
msgstr "产品已索引"

#, php-format
msgid "%d content items discovered by AI crawlers"
msgstr "%d 个内容条目已被 AI 爬虫发现"

msgid "Add products in WooCommerce → Products"
msgstr "在 WooCommerce → 产品 中添加产品"

msgid "Add posts in WordPress → Posts"
msgstr "在 WordPress → 文章 中添加文章"

msgid "AI Crawlers Found You"
msgstr "AI 爬虫已发现你"

#, php-format
msgid "%d crawler visits today"
msgstr "今天 %d 次爬虫访问"

msgid "ChatGPT & other AIs will discover your store"
msgstr "ChatGPT 和其他 AI 将发现你的店铺"

msgid "ChatGPT & other AIs will discover your site"
msgstr "ChatGPT 和其他 AI 将发现你的网站"

msgid "ChatGPT Connected"
msgstr "ChatGPT 已连接"

#, php-format
msgid "%d API calls today — store is live"
msgstr "今天 %d 次 API 调用 — 店铺已上线"

msgid "Paste MCP config into ChatGPT (see below)"
msgstr "将 MCP 配置粘贴到 ChatGPT（见下方）"

