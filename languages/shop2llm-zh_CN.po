msgstr "高级用户"

msgid "Go to Settings tab → Connection Config → paste into ChatGPT to reach the next milestone"
msgstr "前往 设置 标签 → 连接配置 → 粘贴到 ChatGPT 以达成下一个里程碑"

msgid "AI Visibility Summary"
msgstr "AI 可见度摘要"

msgid "Today's AI activity at a glance: API calls, crawler bots, searches, and tools available."
msgstr "今日 AI 活动一览：API 调用、爬虫机器人、搜索次数和可用工具。"

msgid "Connected"
msgstr "已连接"

msgid "Disabled"
msgstr "已禁用"

